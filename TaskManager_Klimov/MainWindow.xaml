<Window x:Class="TaskManager_Klimov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager_Klimov"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinHeight="450" MinWidth="800" FontFamily="Bahnschrift" WindowStyle="None">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background">
                <Setter.Value>
                    <ImageBrush ImageSource="/Images/ic_close.png"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#00FFFF00"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Background="#F0F0F0">
        <Grid Height="50" VerticalAlignment="Top" Background="White">
            <Grid.Effect>
                <DropShadowEffect Opacity="0.1"/>
            </Grid.Effect>
            <Image Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"
                   Source="/Images/ic_task.png"/>
            <Label Content="Задачник" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                   FontSize="18" HorizontalAlignment="Left" Margin="50,0,0,0"/>
            <Label Content="Поиск:" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                   FontSize="14" HorizontalAlignment="Center" Margin="0,0,130,0"/>
            <TextBox Text="{Binding vm_tasks.SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" FontSize="18" HorizontalAlignment="Center"
                     Margin="100,0,0,0" Height="25" Width="175"/>
            <Button Command="{Binding OnClose}" Width="20" Height="20" VerticalAlignment="Top"
                    HorizontalAlignment="Right" Margin="15">
                <Button.Effect>
                    <DropShadowEffect Opacity="0.5" BlurRadius="3" ShadowDepth="3"/>
                </Button.Effect>
            </Button>
        </Grid>
        <Frame x:Name="frame" NavigationUIVisibility="Hidden" Margin="0,55,0,0"/>
    </Grid>
</Window>
